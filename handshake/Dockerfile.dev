# Development image for docker compose: source is mounted, gems are cached.
ARG RUBY_VERSION=4.0.10
FROM docker.io/library/ruby:$RUBY_VERSION-slim
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y build-essential git libpq-dev libyaml-dev pkg-config postgresql-client curl && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives
WORKDIR /rails
ENV BUNDLE_PATH=/bundle
EXPOSE 3000
CMD ["bash", "-c", "bundle check || bundle install; bin/rails db:prepare && bin/rails server -b 0.0.0.0"]
