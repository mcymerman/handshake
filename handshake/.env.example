# Copy to .env (never commit it) and fill in. Every variable the app reads:

# --- Required in production ---
# PostgreSQL connection (Render/Fly/Kamal accessory provide this).
DATABASE_URL=postgres://handshake:CHANGE_ME@db-host:5432/handshake_production
# 64+ random characters: bin/rails secret
SECRET_KEY_BASE=
# Message and reveal-detail encryption: run `bin/rails db:encryption:init`
# and copy the three values here. Losing them makes stored messages unreadable.
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
# Comma-separated host names the app answers to.
APP_HOSTS=handshake.example.com

# --- Optional ---
# Admin pages (/admin) stay switched off unless this is at least 12 characters.
ADMIN_PASSWORD=
ADMIN_USER=admin
# Run background jobs (expiry purges) inside the web process. Recommended for one server.
SOLID_QUEUE_IN_PUMA=true
# Pilot demo mode: a bot "demo friend" to try every flow alone. Off in production by default.
DEMO_MODE=false
# Local time zone for opening hours and daily counts.
APP_TIME_ZONE=Eastern Time (US & Canada)
# Puma threads per process, and log level (info logs no SQL; never use debug in production).
RAILS_MAX_THREADS=3
RAILS_LOG_LEVEL=info
# Only for running the production image over plain http on your own machine.
FORCE_SSL=true

# --- Local development only (docker compose / non-default Postgres) ---
DB_HOST=
DB_USER=
DB_PASSWORD=
