<% content_for :title, "Handshake: keep talking without swapping numbers" %>
<section class="card stack">
  <h1>Met someone? Keep talking, without swapping numbers.</h1>
  <ol class="steps">
    <li><span>You each see a short code, like <strong class="nowrap">47-12-83</strong>.</span></li>
    <li><span>Say it out loud. Each of you types the other's code.</span></li>
    <li><span>A private chat opens for just you two. Share more only if you both want to.</span></li>
  </ol>
  <p class="muted small">No app, no phone number, no email. Chats vanish after 14 days unless you both extend them.</p>

  <%= form_with url: welcome_path, method: :post, class: "stack" do %>
    <label class="check">
      <%= check_box_tag :adult, "1", false, required: true %>
      <span>I'm 18 or older, and I agree to the <%= link_to "terms", terms_path %>.</span>
    </label>
    <%= submit_tag "Get my code", class: "btn btn-block" %>
  <% end %>
  <p class="small muted center"><%= link_to "How it works", how_path %> · <%= link_to "Our privacy promise", privacy_path %></p>
</section>
