<% content_for :title, "#{@venue.name} dashboard · Handshake" %>
<h1><%= @venue.name %></h1>
<p class="muted">Counts only. We never show who connected, what they said, or when exactly.</p>

<section class="card stack">
  <h2>This week's table tent</h2>
  <p>Table words: <strong><%= @venue.table_word.upcase %></strong> · valid <%= week_label(@venue) %></p>
  <div class="row">
    <%= link_to "Print table tent", venue_tent_path(params[:token]), class: "btn btn-small" %>
    <%= link_to "Live display", venue_live_path(params[:token]), class: "btn btn-quiet btn-small" %>
  </div>
  <% @zones.each do |zone| %>
    <p class="small">Zone <%= zone.zone_number %> · <%= zone.label %> · <%= zone.hours_label %><%= " · neighbours #{zone.neighbor_numbers.join(', ')}" if zone.neighbor_numbers.any? %><%= " · theme: #{zone.theme_label}" if zone.theme_label %></p>
  <% end %>
</section>

<section class="card">
  <h2>Last 14 days</h2>
  <table>
    <thead><tr><th>Day</th><th>New connections</th><th>People added to groups</th></tr></thead>
    <tbody>
      <% @days.each do |day| %>
        <% c = @counts[day] %>
        <tr>
          <td><%= day.strftime("%a %b %-d") %></td>
          <td><%= VenueDailyCount.display(c&.connections.to_i) %></td>
          <td><%= VenueDailyCount.display(c&.groups.to_i) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p class="small muted">Numbers from 1 to 2 show as "fewer than 3", so a quiet day can't point at anyone.</p>
</section>
<p class="small muted">Keep this link private: it's your staff key. Lost it? Ask us for a new one.</p>
